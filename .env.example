# ==============================================================================
# Hermes Agent - Environment Configuration Example
# Salin file ini menjadi .env dan masukkan kredensial/token kamu.
# JANGAN PERNAH meng-commit file .env asli yang berisi secret ke Git!
# ==============================================================================

# Model Provider & API Keys
HERMES_CUSTOM_LOCALHOST_20128_API_KEY=your_api_key_here
MODEL_PROVIDER=openrouter
DEFAULT_MODEL=nousresearch/hermes-3-llama-3.1-405b

# Discord Bot Integration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ALLOWED_USERS=*
DISCORD_REQUIRE_MENTION=false
DISCORD_FREE_RESPONSE_CHANNELS=*

# Obsidian Persistent Memory Integration
OBSIDIAN_VAULT_PATH=C:\Users\Username\Documents\Obsidian Vault\Hermes Memory

# Execution & Terminal Settings
TERMINAL_TIMEOUT=120
TERMINAL_LIFETIME_SECONDS=3600

# Browser & Web Tools
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=60
